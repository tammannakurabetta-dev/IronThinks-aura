# ResearchFlow AI - Server Configuration

# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
# Provide your direct Supabase DB URI: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (@google/genai)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Email Dispatcher (resend | nodemailer | test)
EMAIL_PROVIDER=nodemailer
RESEND_API_KEY=
SYSTEM_FROM_EMAIL=reports@researchflow.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Web Scraping Limits & Safeguards
MAX_CONCURRENT_SCRAPES=3
SCRAPER_TIMEOUT_MS=8000
MAX_SOURCE_PAGES=5
